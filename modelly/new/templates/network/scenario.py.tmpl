"""The parameters of one {title} run, and the seed that fixes every draw."""

from modelly.scenarios import Scenario

SEED = 42  # the default seed: pass rng=... for another, reproducible, run


class {scenario_class}(Scenario):
    """Parameters and their defaults; pass ``rng=`` or any of them to override."""

    n: int = 200  # people, one per node
    mean_degree: float = 4.0
    initially_infected: int = 5
    transmission: float = 0.2  # chance per contact per step
    recovery: float = 0.1  # chance per step

    def __init__(self, *, rng=None, **kwargs):
        """Seed with ``SEED`` unless ``rng`` is given, so every run reproduces."""
        super().__init__(rng=SEED if rng is None else rng, **kwargs)
