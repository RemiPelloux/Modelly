\name{modelly_tutorial}
\alias{modelly_tutorial}
\title{The path of a file of the package's tutorial}
\usage{
modelly_tutorial(file = "epidemic.py")
}
\arguments{
\item{file}{A file in inst/tutorial, by default the SIR model.}
}
\value{
Its path, to use in a target ("<path>:Epidemic").
}
\description{
The path of a file of the package's tutorial.
}
\examples{
modelly_tutorial()
}
